# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patronum

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Anthropic Claude
ANTHROPIC_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# HeyGen
HEYGEN_API_KEY=
HEYGEN_MODERATOR_AVATAR_ID=

# Speech-to-text (optional)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# AWS S3 (photo and audio storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# CORS
CLIENT_URL=http://localhost:5173

# Resend (email)
RESEND_API_KEY=
ADMIN_EMAIL=admin@example.com

# Speech graph service
SPEECH_GRAPH_SERVICE_URL=http://localhost:8001
